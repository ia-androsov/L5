Cell["\<\
Det[M] followed by Together takes hours, so the determinant is computed by \
Gaussian elimination with factorization at each step.\
\>", "Text",ExpressionUUID->"7cf1eaea-6ad6-8547-a86d-140da87f9780"],

Cell[BoxData[
 RowBox[{
  RowBox[{"detM", "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"Map", "[", 
         RowBox[{"Factor", ",", 
          RowBox[{"Together", "[", "M", "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
       RowBox[{"d", "=", "1"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"Factor", "[", 
           RowBox[{"d", 
            RowBox[{"m", "[", 
             RowBox[{"[", 
              RowBox[{"j", ",", "j"}], "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"Factor", "/@", 
             RowBox[{"Together", "[", 
              RowBox[{
               RowBox[{"m", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", 
               RowBox[{
                RowBox[{
                 RowBox[{"m", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
                 RowBox[{"m", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ",", "j"}], "]"}], "]"}]}], 
                RowBox[{"m", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"j", "+", "1"}], ",", "6"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "6"}], "}"}]}], "]"}], ";", "d"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  " In[19]:=",ExpressionUUID->"c98d10c2-f5b4-6a4b-966f-f7c3dda0ca62"]
}, Open  ]],

