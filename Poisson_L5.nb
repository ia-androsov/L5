}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Exponent", "[", 
      RowBox[{"A", ",", 
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Lambda]", ",", "#"}], "]"}]}], "]"}], "&"}], "/@", 
    RowBox[{"Range", "[", "4", "]"}]}], ",", 
