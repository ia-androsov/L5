Cell["\<\
Symmetry: the cyclic permutation and the transpositions \!\(\*SubscriptBox[\(\
\[Lambda]\), \(1\)]\)\[LeftRightArrow]\!\(\*SubscriptBox[\(\[Lambda]\), \
\(2\)]\), \!\(\*SubscriptBox[\(\[Lambda]\), \
\(1\)]\)\[LeftRightArrow]\!\(\*SubscriptBox[\(\[Lambda]\), \(3\)]\).\
\>", "Text",ExpressionUUID->"c9543f5d-7655-1247-9788-8e142b0024e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"perm", "[", "s_", "]"}], ":=", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Subscript", "[", 
       RowBox[{"\[Lambda]", ",", "#"}], "]"}], "&"}], "/@", 
     RowBox[{"Range", "[", "4", "]"}]}], "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Lambda]", ",", "#"}], "]"}], "&"}], "/@", "s"}], ")"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  " In[47]:=",ExpressionUUID->"2052b4b3-51ab-d84e-a877-a9ebf27a9674"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"A", "-", 
        RowBox[{"(", 
         RowBox[{"A", "/.", 
          RowBox[{"perm", "[", "s", "]"}]}], ")"}]}], "]"}], "===", "0"}], ",", 
     RowBox[{
      RowBox[{"Factor", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Res", "/", "A"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Res", "/", "A"}], ")"}], "/.", 
          RowBox[{"perm", "[", "s", "]"}]}], ")"}]}], "]"}], "===", "1"}]}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3", ",", "4", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "1", ",", "3", ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "2", ",", "1", ",", "4"}], "}"}]}], "}"}]}], 
    "}"}]}], "]"}]], "Input",
